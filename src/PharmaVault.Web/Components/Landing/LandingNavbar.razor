@using Microsoft.AspNetCore.Components.Authorization

<header class="sticky-top bg-white border-bottom shadow-sm">
    <nav class="navbar navbar-expand-lg navbar-light container py-2 py-lg-3">
        <!-- Logo / Nombre del Proyecto -->
        <a class="navbar-brand d-flex align-items-center text-decoration-none" href="/">
            <span class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-2">
                <i class="bi bi-capsule fs-4"></i>
            </span>
            <span class="fw-bold fs-4 tracking-tight text-dark">
                Pharma<span class="text-primary">Vault</span>
            </span>
        </a>

        <!-- Botón Hamburguesa Responsivo -->
        <button class="navbar-toggler border-0 shadow-none p-2 @(_isNavCollapsed ? "collapsed" : "")" 
                type="button" 
                @onclick="ToggleNavMenu" 
                aria-controls="landingNavbarNav" 
                aria-expanded="@(!_isNavCollapsed)" 
                aria-label="@Loc["Lang_Select"]">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Enlaces Colapsables -->
        <div class="navbar-collapse @(_isNavCollapsed ? "collapse" : "collapse show")" id="landingNavbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-1 gap-lg-2 my-3 my-lg-0">
                <li class="nav-item">
                    <a class="nav-link px-2 fw-medium text-secondary text-hover-primary" href="/#top" @onclick="CloseNavMenu">
                        <i class="bi bi-house-door me-1 d-lg-none"></i>@Loc["Nav_Home"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 fw-medium text-secondary text-hover-primary" href="/#features" @onclick="CloseNavMenu">
                        <i class="bi bi-stars me-1 d-lg-none"></i>@Loc["Nav_Features"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 fw-medium text-secondary text-hover-primary" href="/#catalog" @onclick="CloseNavMenu">
                        <i class="bi bi-capsule me-1 d-lg-none"></i>@Loc["Nav_Catalog"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 fw-medium text-secondary text-hover-primary" href="/#inventory" @onclick="CloseNavMenu">
                        <i class="bi bi-box-seam me-1 d-lg-none"></i>@Loc["Nav_Inventory"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 fw-medium text-secondary text-hover-primary" href="/#contact" @onclick="CloseNavMenu">
                        <i class="bi bi-envelope me-1 d-lg-none"></i>@Loc["Nav_Contact"]
                    </a>
                </li>
            </ul>

            <!-- Acciones de Autenticación y Selector de Idioma -->
            <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2 ms-lg-3 pt-2 pt-lg-0 border-top border-lg-0">
                <div class="d-flex justify-content-center py-1 py-lg-0 me-lg-2">
                    <LanguageSelector />
                </div>

                <AuthorizeView>
                    <Authorized>
                        <a href="/dashboard" class="btn btn-outline-primary fw-semibold px-3 py-2 text-center" @onclick="CloseNavMenu">
                            <i class="bi bi-speedometer2 me-1"></i> @Loc["Nav_Dashboard"]
                        </a>
                        <form action="/logout" method="post" class="d-inline m-0">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-light text-danger fw-medium px-3 py-2 w-100">
                                <i class="bi bi-box-arrow-right me-1"></i> @Loc["Nav_Logout"]
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-outline-primary fw-semibold px-3 py-2 text-center" @onclick="CloseNavMenu">
                            <i class="bi bi-box-arrow-in-right me-1"></i> @Loc["Nav_Login"]
                        </a>
                        <a href="/register" class="btn btn-primary fw-semibold px-3 py-2 text-center shadow-sm" @onclick="CloseNavMenu">
                            <i class="bi bi-person-plus me-1"></i> @Loc["Nav_Register"]
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>
</header>

@code {
    private bool _isNavCollapsed = true;

    private void ToggleNavMenu()
    {
        _isNavCollapsed = !_isNavCollapsed;
    }

    private void CloseNavMenu()
    {
        _isNavCollapsed = true;
    }
}
