@inherits LayoutComponentBase
@using PharmaVault.Web.Components.Landing

<div id="top" class="landing-layout d-flex flex-column min-vh-100 bg-white">
    <LandingNavbar />
    
    <main class="flex-grow-1">
        <GlobalErrorBoundary>
            @Body
        </GlobalErrorBoundary>
    </main>

    <LandingFooter />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
