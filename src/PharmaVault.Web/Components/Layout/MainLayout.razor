@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <form action="/logout" method="post" class="m-0" data-enhance="false">
            
                <AntiforgeryToken />

                <button type="submit" class="btn btn-link text-dark text-decoration-none fw-semibold">
                    Log Out
                </button>
            </form>
        </div>

        <article class="content px-4">
            <GlobalErrorBoundary>
                @Body
            </GlobalErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
