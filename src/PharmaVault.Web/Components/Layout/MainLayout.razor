@inherits LayoutComponentBase
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-end gap-3">
            <LanguageSelector />

            <form action="/logout" method="post" class="m-0" data-enhance="false">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-link text-dark text-decoration-none fw-semibold">
                    <i class="bi bi-box-arrow-right me-1"></i>
                    @Loc["App_Logout"]
                </button>
            </form>
        </div>

        <article class="content px-4">
            <GlobalErrorBoundary>
                @Body
            </GlobalErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Loc["Error_Unhandled"]
    <a href="." class="reload">@Loc["Error_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        CultureState.OnCultureChanged += HandleCultureChanged;
    }

    private void HandleCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CultureState.OnCultureChanged -= HandleCultureChanged;
    }
}
