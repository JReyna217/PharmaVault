@page "/dashboard"

<PageTitle>Dashboard - PharmaVault</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-primary">Welcome to PharmaVault</h1>
            <p class="lead text-muted">Today is @CurrentDate</p>
            <hr class="my-4" />
            
            <div class="alert alert-info shadow-sm" role="alert">
                <h4 class="alert-heading">Work in Progress!</h4>
                <p>This is your central hub. Soon, we will display your total inventory, low-stock medicine alerts, and recent system activity right here.</p>
            </div>
        </div>
    </div>
</div>