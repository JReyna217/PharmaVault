@page "/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Dashboard - PharmaVault</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-primary">Welcome to PharmaVault, @UserName</h1>
            <p class="lead text-muted">Today is @CurrentDate</p>
            <hr class="my-4" />
        </div>
    </div>

    @if (_stats == null)
    {
        <div class="d-flex align-items-center text-primary">
            <div class="spinner-border ms-auto" role="status" aria-hidden="true"></div>
            <strong>Loading your statistics...</strong>
        </div>
    }
    else if (_stats.TotalStock == 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info shadow-sm border-0 border-start border-info border-5" role="alert">
                    <h4 class="alert-heading"><i class="bi bi-info-circle me-2"></i>No stock registered yet!</h4>
                    <p>Your inventory is currently empty. Head over to the <a href="inventory" class="alert-link">Inventory</a> section to start adding your first medicines.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card text-white bg-primary h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0 text-uppercase fw-bold opacity-75">Total Units</h6>
                                <h2 class="mt-2 mb-0 display-5 fw-bold">@_stats.TotalStock</h2>
                            </div>
                            <i class="bi bi-box-seam fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-success h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0 text-uppercase fw-bold opacity-75">Good Condition</h6>
                                <h2 class="mt-2 mb-0 display-5 fw-bold">@_stats.GoodStock</h2>
                            </div>
                            <i class="bi bi-check-circle fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-dark bg-warning h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0 text-uppercase fw-bold opacity-75">Expiring Soon (30d)</h6>
                                <h2 class="mt-2 mb-0 display-5 fw-bold">@_stats.ExpiringSoonStock</h2>
                            </div>
                            <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-danger h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0 text-uppercase fw-bold opacity-75">Expired</h6>
                                <h2 class="mt-2 mb-0 display-5 fw-bold">@_stats.ExpiredStock</h2>
                            </div>
                            <i class="bi bi-x-octagon fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                        <h5 class="mb-0 fw-bold text-secondary">Inventory Health</h5>
                    </div>
                    <div class="card-body d-flex flex-column justify-content-center align-items-center py-5">
                        <i class="bi bi-pie-chart text-muted mb-3" style="font-size: 4rem;"></i>
                        <p class="text-muted">Chart integration pending...</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>