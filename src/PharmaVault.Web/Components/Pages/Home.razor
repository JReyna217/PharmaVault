@page "/"
@page "/home"
@layout Layout.LandingLayout
@rendermode InteractiveServer

<PageTitle>PharmaVault - Gestión Inteligente de Medicamentos y Botiquín Familiar</PageTitle>

<!-- ========================================================================= -->
<!-- 1. HERO SECTION                                                           -->
<!-- ========================================================================= -->
<section class="hero-section py-5 bg-gradient-hero border-bottom">
    <div class="container py-lg-4">
        <div class="row align-items-center g-5">
            <!-- Columna Izquierda: Mensaje de Valor y Llamados a la Acción -->
            <div class="col-lg-7 text-center text-lg-start">
                <div class="d-inline-flex align-items-center gap-2 bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill mb-3 small fw-semibold">
                    <i class="bi bi-shield-check"></i> Control y Seguridad Farmacéutica
                </div>

                <h1 class="display-4 fw-bold text-dark lh-sm mb-3">
                    El control definitivo de tu <span class="text-primary">botiquín médico</span> familiar.
                </h1>

                <p class="lead text-muted mb-4 fs-5">
                    PharmaVault resuelve el desorden y los riesgos de medicinas vencidas. Monitorea la salud de tus existencias con alertas visuales preventivas, mantén un catálogo centralizado de dosis y presentaciones, y evita compras innecesarias.
                </p>

                <!-- Botones de Acción (CTAs) -->
                <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3 mb-4">
                    <a href="/register" class="btn btn-primary btn-lg px-4 py-3 fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-in-right fs-5"></i>
                        <span>Comenzar Ahora Gratis</span>
                    </a>
                    <a href="/login" class="btn btn-outline-primary btn-lg px-4 py-3 fw-semibold d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-person-check fs-5"></i>
                        <span>Iniciar Sesión</span>
                    </a>
                </div>

                <!-- Insignias de Confianza -->
                <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3 text-secondary small">
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>Cero medicamentos vencidos</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>100% privado y seguro</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>Acceso desde cualquier dispositivo</span>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Vista Previa Simulada del Dashboard y Medicamentos -->
            <div class="col-lg-5">
                <div class="hero-preview-card card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-heart-pulse-fill"></i>
                            <span class="fw-bold">Estado del Botiquín</span>
                        </div>
                        <span class="badge bg-white text-primary rounded-pill px-2 py-1">En tiempo real</span>
                    </div>

                    <div class="card-body p-4 bg-light">
                        <!-- Métricas Rápidas de Semáforo -->
                        <div class="row g-2 mb-3 text-center">
                            <div class="col-4">
                                <div class="bg-success bg-opacity-10 text-success p-2 rounded-3 border border-success border-opacity-25">
                                    <div class="fw-bold fs-5">24</div>
                                    <div class="small fw-semibold">Buen Estado</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-warning bg-opacity-10 text-warning-emphasis p-2 rounded-3 border border-warning border-opacity-25">
                                    <div class="fw-bold fs-5">3</div>
                                    <div class="small fw-semibold">Por Vencer</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-danger bg-opacity-10 text-danger p-2 rounded-3 border border-danger border-opacity-25">
                                    <div class="fw-bold fs-5">1</div>
                                    <div class="small fw-semibold">Vencido</div>
                                </div>
                            </div>
                        </div>

                        <!-- Lista de Medicamentos de Demostración -->
                        <div class="d-flex flex-column gap-2">
                            <!-- Ítem 1: Vigente -->
                            <div class="p-2 bg-white rounded-3 shadow-sm border d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary-subtle text-primary p-2 rounded-circle">
                                        <i class="bi bi-capsule"></i>
                                    </span>
                                    <div>
                                        <div class="fw-bold text-dark small">Paracetamol</div>
                                        <div class="text-muted smaller">500mg &bull; Tabletas &bull; 20 uds</div>
                                    </div>
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                    <i class="bi bi-check2"></i> Vigente
                                </span>
                            </div>

                            <!-- Ítem 2: Por Vencer -->
                            <div class="p-2 bg-white rounded-3 shadow-sm border d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-warning-subtle text-warning-emphasis p-2 rounded-circle">
                                        <i class="bi bi-capsule"></i>
                                    </span>
                                    <div>
                                        <div class="fw-bold text-dark small">Amoxicilina</div>
                                        <div class="text-muted smaller">250mg/5ml &bull; Suspensión &bull; 1 fco</div>
                                    </div>
                                </div>
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">
                                    <i class="bi bi-exclamation-triangle"></i> Por vencer (15 d)
                                </span>
                            </div>

                            <!-- Ítem 3: Vencido -->
                            <div class="p-2 bg-white rounded-3 shadow-sm border d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-danger-subtle text-danger p-2 rounded-circle">
                                        <i class="bi bi-capsule"></i>
                                    </span>
                                    <div>
                                        <div class="fw-bold text-dark small">Ibuprofeno</div>
                                        <div class="text-muted smaller">400mg &bull; Cápsulas &bull; 8 uds</div>
                                    </div>
                                </div>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
                                    <i class="bi bi-x-circle"></i> Vencido
                                </span>
                            </div>
                        </div>

                        <!-- Pie de Demostración -->
                        <div class="mt-3 text-center">
                            <span class="badge bg-secondary bg-opacity-10 text-muted px-3 py-2 rounded-pill small">
                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Blazor Interactive Server en tiempo real
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================================= -->
<!-- 2. CARACTERÍSTICAS PRINCIPALES (FEATURES SECTION)                         -->
<!-- ========================================================================= -->
<section id="features" class="py-5 bg-white">
    <div class="container py-lg-4">
        <div class="text-center mb-5 max-w-700 mx-auto">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill mb-2 fw-semibold">
                Capacidades de la Plataforma
            </span>
            <h2 class="display-6 fw-bold text-dark mb-3">
                Diseñado para simplificar la gestión farmacéutica
            </h2>
            <p class="text-muted">
                PharmaVault combina tecnología moderna en .NET 10 con un enfoque centrado en la seguridad y la simplicidad para el hogar.
            </p>
        </div>

        <div class="row g-4">
            <!-- Característica 1: Semáforo de Vencimiento -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card card h-100 p-4 border rounded-4 shadow-sm">
                    <div class="feature-icon-wrapper mb-3 bg-danger bg-opacity-10 text-danger rounded-3 d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-calendar2-heart fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Control y Alertas de Vencimiento</h5>
                    <p class="text-muted small mb-0">
                        Clasificación visual inmediata en 3 estados: Buen Estado, Próximo a Vencer y Vencido. Dile adiós a desechar medicinas útiles o consumir fármacos caducados.
                    </p>
                </div>
            </div>

            <!-- Característica 2: Catálogo Maestro -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card card h-100 p-4 border rounded-4 shadow-sm">
                    <div class="feature-icon-wrapper mb-3 bg-primary bg-opacity-10 text-primary rounded-3 d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-capsule fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Catálogo Maestro Centralizado</h5>
                    <p class="text-muted small mb-0">
                        Base de datos estandarizada con nombres, presentaciones farmacéuticas (cápsulas, tabletas, jarabes, inyecciones) y dosis exactas para mantener todo bajo control.
                    </p>
                </div>
            </div>

            <!-- Característica 3: Inventario Inteligente (CRUD) -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card card h-100 p-4 border rounded-4 shadow-sm">
                    <div class="feature-icon-wrapper mb-3 bg-success bg-opacity-10 text-success rounded-3 d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Inventario Personalizado</h5>
                    <p class="text-muted small mb-0">
                        Agrega, actualiza y elimina existencias en tiempo real. Vincula cada lote a tu usuario para registrar fechas de compra, caducidad y cantidades precisas.
                    </p>
                </div>
            </div>

            <!-- Característica 4: Búsqueda con Cero Latencia -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card card h-100 p-4 border rounded-4 shadow-sm">
                    <div class="feature-icon-wrapper mb-3 bg-info bg-opacity-10 text-info rounded-3 d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-search fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Búsqueda Reactiva sin Esperas</h5>
                    <p class="text-muted small mb-0">
                        Filtrado ultrarrápido en memoria con LINQ sobre Blazor Interactive Server. Encuentra cualquier fármaco al instante sin recargas molestas de pantalla.
                    </p>
                </div>
            </div>

            <!-- Característica 5: Dashboard Analítico -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card card h-100 p-4 border rounded-4 shadow-sm">
                    <div class="feature-icon-wrapper mb-3 bg-warning bg-opacity-10 text-warning-emphasis rounded-3 d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-pie-chart-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Analítica y Gráficos Visuales</h5>
                    <p class="text-muted small mb-0">
                        Panel de control con gráficos interactivos impulsados por Blazor-ApexCharts que resumen la salud global de tu botiquín en una sola mirada.
                    </p>
                </div>
            </div>

            <!-- Característica 6: Seguridad de Grado Criptográfico -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card card h-100 p-4 border rounded-4 shadow-sm">
                    <div class="feature-icon-wrapper mb-3 bg-secondary bg-opacity-10 text-secondary rounded-3 d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Privacidad y Seguridad Robusta</h5>
                    <p class="text-muted small mb-0">
                        Contraseñas protegidas mediante algoritmos de hashing criptográfico BCrypt y autenticación por cookies aislada con persistencia relacional en PostgreSQL.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================================= -->
<!-- 3. MÓDULOS DEL SISTEMA: CATÁLOGO E INVENTARIO                            -->
<!-- ========================================================================= -->
<section id="catalog" class="py-5 bg-light border-top border-bottom">
    <div class="container py-lg-4">
        <!-- Subsección: Catálogo Maestro -->
        <div class="row align-items-center g-5 mb-5">
            <div class="col-lg-6 order-lg-1 order-2">
                <div class="card border-0 shadow rounded-4 overflow-hidden">
                    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                        <div class="fw-bold text-primary">
                            <i class="bi bi-capsule me-2"></i>Catálogo de Fármacos
                        </div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill">Estandarizado</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Medicamento</th>
                                    <th>Forma</th>
                                    <th>Dosis</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                <tr>
                                    <td class="fw-semibold">Amoxicilina</td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-dark">Suspensión</span></td>
                                    <td>250mg / 5ml</td>
                                    <td><span class="badge bg-success-subtle text-success">Activo</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Ibuprofeno</td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-dark">Cápsulas</span></td>
                                    <td>400mg</td>
                                    <td><span class="badge bg-success-subtle text-success">Activo</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Loratadina</td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-dark">Jarabe</span></td>
                                    <td>100mg / 100ml</td>
                                    <td><span class="badge bg-success-subtle text-success">Activo</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Omeprazol</td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-dark">Cápsulas</span></td>
                                    <td>20mg</td>
                                    <td><span class="badge bg-success-subtle text-success">Activo</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 order-lg-2 order-1">
                <div class="ps-lg-4">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill mb-2 fw-semibold">
                        Módulo Central
                    </span>
                    <h3 class="display-6 fw-bold text-dark mb-3">Catálogo Maestro de Medicamentos</h3>
                    <p class="text-muted mb-4">
                        Elimina la confusión de dosis y formatos. El catálogo permite registrar cada producto farmacéutico con su denominación común, forma farmacéutica y dosificación adecuada para que cualquier miembro de tu familia lo identifique sin errores.
                    </p>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-4">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check2-circle text-primary fs-5"></i>
                            <span>Soporta tabletas, jarabes, inyecciones, soluciones y ungüentos.</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check2-circle text-primary fs-5"></i>
                            <span>Registro único reutilizable para múltiples entradas de inventario.</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check2-circle text-primary fs-5"></i>
                            <span>Búsqueda y filtrado instantáneo por nombre o principio activo.</span>
                        </li>
                    </ul>
                    <a href="/medicines" class="btn btn-primary fw-semibold px-4 py-2">
                        <i class="bi bi-eye me-1"></i> Explorar Catálogo
                    </a>
                </div>
            </div>
        </div>

        <!-- Subsección: Inventario Activo -->
        <div id="inventory" class="row align-items-center g-5 pt-4">
            <div class="col-lg-6">
                <div class="pe-lg-4">
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill mb-2 fw-semibold">
                        Control de Existencias
                    </span>
                    <h3 class="display-6 fw-bold text-dark mb-3">Inventario Inteligente y Alertas</h3>
                    <p class="text-muted mb-4">
                        Toma decisiones oportunas antes de ir a la farmacia. Tu inventario te muestra exactamente cuántas unidades tienes de cada medicina y cuándo caducan, alertándote con anticipación para evitar gastos duplicados.
                    </p>
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 bg-white rounded-3 border shadow-sm">
                                <div class="text-primary fw-bold fs-4 mb-1">0%</div>
                                <div class="small text-muted">Compras innecesarias por duplicación</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-white rounded-3 border shadow-sm">
                                <div class="text-success fw-bold fs-4 mb-1">100%</div>
                                <div class="small text-muted">Tranquilidad para tu salud familiar</div>
                            </div>
                        </div>
                    </div>
                    <a href="/inventory" class="btn btn-outline-primary fw-semibold px-4 py-2">
                        <i class="bi bi-box-seam me-1"></i> Ir a Mi Inventario
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow rounded-4 overflow-hidden">
                    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                        <div class="fw-bold text-success">
                            <i class="bi bi-boxes me-2"></i>Existencias y Caducidades
                        </div>
                        <span class="badge bg-success-subtle text-success rounded-pill">Monitoreo Activo</span>
                    </div>
                    <div class="card-body p-4 bg-white">
                        <div class="alert alert-warning border-0 border-start border-warning border-4 shadow-sm mb-3 p-3">
                            <div class="d-flex align-items-center gap-2 fw-bold text-warning-emphasis mb-1">
                                <i class="bi bi-bell-fill"></i> Alerta Preventiva
                            </div>
                            <div class="small text-secondary">
                                Tienes <strong>3 medicamentos</strong> que vencen en los próximos 30 días. Recuerda renovar receta o reabastecer a tiempo.
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <div class="fw-bold text-dark">Amoxicilina 250mg</div>
                                <div class="text-muted smaller">Lote #AB-204 &bull; Vence: en 15 días</div>
                            </div>
                            <span class="badge bg-warning text-dark px-3 py-2">Por vencer</span>
                        </div>

                        <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold text-dark">Loratadina 10mg</div>
                                <div class="text-muted smaller">Lote #LK-991 &bull; Vence: hace 5 días</div>
                            </div>
                            <span class="badge bg-danger px-3 py-2">Descartar</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================================= -->
<!-- 4. SECCIÓN DE CONTACTO Y SOPORTE (CONTACT SECTION)                        -->
<!-- ========================================================================= -->
<section id="contact" class="py-5 bg-white">
    <div class="container py-lg-4">
        <div class="text-center mb-5 max-w-700 mx-auto">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill mb-2 fw-semibold">
                Atención y Soporte
            </span>
            <h2 class="display-6 fw-bold text-dark mb-3">
                ¿Tienes preguntas o sugerencias?
            </h2>
            <p class="text-muted">
                Nuestro equipo está listo para ayudarte a configurar y sacar el máximo provecho de PharmaVault para tu hogar o institución.
            </p>
        </div>

        <div class="row g-5 justify-content-center">
            <!-- Formulario de Contacto -->
            <div class="col-lg-7">
                <div class="card border rounded-4 shadow-sm p-4 p-md-5">
                    <h4 class="fw-bold text-dark mb-4">Envíanos un mensaje</h4>

                    @if (ShowSuccessAlert)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 border-start border-success border-4 shadow-sm mb-4" role="alert">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                                <div>
                                    <strong>¡Mensaje recibido con éxito!</strong>
                                    <div class="small">Gracias por escribirnos. Nuestro equipo te responderá a la brevedad posible.</div>
                                </div>
                            </div>
                            <button type="button" class="btn-close" @onclick="() => ShowSuccessAlert = false" aria-label="Cerrar"></button>
                        </div>
                    }

                    <EditForm Model="@ContactModel" OnValidSubmit="HandleContactSubmitAsync">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <!-- Nombre -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="contactName" class="form-control" @bind-Value="ContactModel.Name" placeholder="Tu nombre completo" />
                                    <label for="contactName">Nombre completo</label>
                                    <ValidationMessage For="() => ContactModel.Name" class="text-danger small mt-1" />
                                </div>
                            </div>

                            <!-- Correo Electrónico -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="contactEmail" class="form-control" @bind-Value="ContactModel.Email" placeholder="correo@ejemplo.com" />
                                    <label for="contactEmail">Correo electrónico</label>
                                    <ValidationMessage For="() => ContactModel.Email" class="text-danger small mt-1" />
                                </div>
                            </div>

                            <!-- Asunto -->
                            <div class="col-12">
                                <div class="form-floating">
                                    <InputText id="contactSubject" class="form-control" @bind-Value="ContactModel.Subject" placeholder="Motivo de tu mensaje" />
                                    <label for="contactSubject">Asunto</label>
                                    <ValidationMessage For="() => ContactModel.Subject" class="text-danger small mt-1" />
                                </div>
                            </div>

                            <!-- Mensaje -->
                            <div class="col-12">
                                <div class="form-floating">
                                    <InputTextArea id="contactMessage" class="form-control" style="height: 140px;" @bind-Value="ContactModel.Message" placeholder="Escribe tu mensaje aquí..." />
                                    <label for="contactMessage">Mensaje detallado</label>
                                    <ValidationMessage For="() => ContactModel.Message" class="text-danger small mt-1" />
                                </div>
                            </div>

                            <!-- Botón de Envío -->
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2" disabled="@IsSubmitting">
                                    @if (IsSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Enviando mensaje...</span>
                                    }
                                    else
                                    {
