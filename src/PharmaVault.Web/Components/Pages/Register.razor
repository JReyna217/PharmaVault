@page "/register"
@layout Layout.AuthLayout
@rendermode InteractiveServer

<PageTitle>@Loc["Register_Title"] - PharmaVault</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="d-flex justify-content-end mb-2">
                <LanguageSelector />
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <a href="/" class="text-decoration-none">
                            <span class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle p-2 mb-2">
                                <i class="bi bi-capsule fs-3"></i>
                            </span>
                            <h3 class="card-title fw-bold text-dark m-0">Pharma<span class="text-primary">Vault</span></h3>
                        </a>
                        <div class="text-muted small mt-1">@Loc["Register_Title"]</div>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @ErrorMessage
                        </div>
                    }

                    <EditForm Model="@RegisterModel" OnValidSubmit="HandleRegisterAsync" FormName="RegisterForm">
                        <DataAnnotationsValidator />

                        <div class="form-floating mb-3">
                            <InputText id="fullName" class="form-control"
                                @bind-Value="RegisterModel.FullName"
                                placeholder="@Loc["Register_FullNamePlaceholder"]" />
                            <label for="fullName">@Loc["Register_FullNameLabel"]</label>
                            <ValidationMessage For="() => RegisterModel.FullName" class="text-danger small" />
                        </div>

                        <div class="form-floating mb-3">
                            <InputText id="email" class="form-control"
                                @bind-Value="RegisterModel.Email"
                                placeholder="@Loc["Login_EmailPlaceholder"]" />
                            <label for="email">@Loc["Login_EmailLabel"]</label>
                            <ValidationMessage For="() => RegisterModel.Email" class="text-danger small" />
                        </div>

                        <div class="form-floating mb-4">
                            <InputText id="password" type="password" class="form-control"
                                       @bind-Value="RegisterModel.Password"
                                       placeholder="@Loc["Login_PasswordPlaceholder"]" />
                            <label for="password">@Loc["Login_PasswordLabel"]</label>
                            <ValidationMessage For="() => RegisterModel.Password" class="text-danger small" />
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 fw-semibold shadow-sm">@Loc["Register_Btn"]</button>
                    </EditForm>

                    <div class="mt-4 text-center">
                        <span class="text-muted small">@Loc["Register_HaveAccount"] <a href="/login" class="text-decoration-none fw-semibold">@Loc["Register_LoginPrompt"]</a></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
